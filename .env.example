# Local development only. Keep values unquoted for Spring's properties reader.
DB_USERNAME=lingolens
DB_PASSWORD=lingolens_password
DB_URL=jdbc:postgresql://127.0.0.1:5433/lingolens
JWT_SECRET=dev-only-lingolens-secret-key-change-before-production-2026
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: set both to bootstrap an admin (password must have at least 12 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
